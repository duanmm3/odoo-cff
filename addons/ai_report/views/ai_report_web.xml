<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ai_report_chat_page" name="AI Report 对话页面">
        <t t-call="web.layout">
            <t t-set="title" t-value="'AI智能报表 - 对话式数据分析'"/>
            <t t-call-assets="web.assets_frontend"/>
            <script type="text/javascript" src="/ai_report/static/src/js/chart.js"></script>
            <div class="container-fluid ai-chat-container">
                <div class="row h-100 no-gutters">
                    <!-- 左侧会话列表 -->
                    <div class="chat-sidebar">
                        <div class="header">
                            <a href="/web" class="back-home-btn" style="display: flex; align-items: center; gap: 8px; color: #3E6AE1; text-decoration: none; font-size: 14px; margin-bottom: 12px;">
                                <i class="fa fa-home"></i> 返回 HOME
                            </a>
                            <!--h5><i class="fa fa-comments"></i> AI智能报表</h5-->
                        </div>
                        <div style="padding: 16px;">
                            <button class="btn new-chat-btn w-100">
                                <i class="fa fa-plus"></i> 新建会话
                            </button>
                        </div>
                        <div class="chat-session-list" id="chatSessionList">
                            <div class="text-center text-muted p-3">
                                <small>暂无历史会话</small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 右侧对话区域 -->
                    <div class="chat-main">
                        <!-- 对话消息区 -->
                        <div class="chat-messages" id="chatMessages">
                            <div class="welcome-message">
                                <div style="margin-bottom: 20px;">
                                    <i class="fa fa-chart-line fa-4x"></i>
                                </div>
                                <h4>欢迎使用 AI 智能报表</h4>
                                <p>用自然语言描述您的数据分析需求</p>
                                <div class="example-queries">
                                    <p>示例查询：</p>
                                    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;">
                                        <button class="btn example-query" data-query="今年的销售额">今年的销售额</button>
                                        <button class="btn example-query" data-query="月度销售趋势分析">月度销售趋势分析</button>
                                        <button class="btn example-query" data-query="畅销产品TOP10排行榜">畅销产品TOP10排行榜</button>
                                        <button class="btn example-query" data-query="产品销售汇总视图">产品销售汇总视图</button>
                                        <button class="btn example-query" data-query="各产品销量排名">各产品销量排名</button>
                                        <button class="btn example-query" data-query="年度采购分析">年度采购分析</button>
                                        <button class="btn example-query" data-query="采购产品排行">采购产品排行</button>
                                        <button class="btn example-query" data-query="采购趋势分析">采购趋势分析</button>
                                        <button class="btn example-query" data-query="库存不足产品预警">库存不足产品预警</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- 输入区域 -->
                        <div class="chat-input-area">
                            <div class="input-wrapper">
                                <textarea 
                                    id="aiQuestionInput" 
                                    class="form-control" 
                                    placeholder="请描述您的数据分析需求，如：今年每月销售额趋势"
                                    rows="1"
                                ></textarea>
                                <button class="send-btn" id="sendBtn">
                                    <i class="fa fa-paper-plane"></i> 发送
                                </button>
                            </div>
                            <div class="input-hint">
                                按 Enter 发送，Shift + Enter 换行
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <script type="text/javascript">
                console.log('[AI Report] Inline script loaded');
            </script>
            <script type="text/javascript" src="/ai_report/static/src/js/ai_report_chat.js?t=20250517"></script>
        </t>
    </template>
</odoo>