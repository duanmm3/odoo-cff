<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_report_chat" model="ir.actions.act_window">
        <field name="name">AI Report 对话</field>
        <field name="res_model">ai.report.chat</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <record id="view_ai_report_chat_tree" model="ir.ui.view">
        <field name="name">ai.report.chat.tree</field>
        <field name="model">ai.report.chat</field>
        <field name="arch" type="xml">
            <list string="对话记录" decoration-info="message_type=='user'" decoration-success="message_type=='assistant'">
                <field name="create_date" string="时间"/>
                <field name="message_type" string="类型"/>
                <field name="content" string="内容"/>
                <field name="result_type" string="结果类型"/>
            </list>
        </field>
    </record>

    <record id="view_ai_report_chat_form" model="ir.ui.view">
        <field name="name">ai.report.chat.form</field>
        <field name="model">ai.report.chat</field>
        <field name="arch" type="xml">
            <form string="对话详情">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="session_id"/>
                        <field name="role"/>
                        <field name="message_type"/>
                        <field name="result_type"/>
                        <field name="content"/>
                        <field name="sql_generated" widget="ace" options="{'mode': 'sql'}"/>
                        <field name="result_json" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>