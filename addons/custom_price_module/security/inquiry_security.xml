<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inquiry Analysis Groups -->
        <record id="group_inquiry_user" model="res.groups">
            <field name="name">Inquiry Analysis / User</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_inquiry_manager" model="res.groups">
            <field name="name">Inquiry Analysis / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_inquiry_user'))]"/>
        </record>

<!-- Access Rules for Inquiry Request -->
<!-- 销售 - 通过模型方法控制权限 -->
        <record id="inquiry_request_rule_sales" model="ir.rule">
            <field name="name">Inquiry Request - Sales Access Own</field>
            <field name="model_id" ref="model_inquiry_request"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- 采购可以看到全部 -->
        <record id="inquiry_request_rule_purchase" model="ir.rule">
            <field name="name">Inquiry Request - Purchase Access All</field>
            <field name="model_id" ref="model_inquiry_request"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- 移除 group_inquiry_user 规则，避免与销售/采购规则冲突 -->
        <!--
        <record id="inquiry_request_rule_user_own" model="ir.rule">
            <field name="name">Inquiry Request - User Own Records</field>
            <field name="model_id" ref="model_inquiry_request"/>
            <field name="groups" eval="[(4, ref('group_inquiry_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        -->

        <record id="inquiry_request_rule_manager" model="ir.rule">
            <field name="name">Inquiry Request - Manager Access</field>
            <field name="model_id" ref="model_inquiry_request"/>
            <field name="groups" eval="[(4, ref('group_inquiry_manager')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

<!-- 采购 - 通过模型方法控制权限 -->
        <record id="inquiry_quote_rule_buyer" model="ir.rule">
            <field name="name">Inquiry Quote - Buyer Access</field>
            <field name="model_id" ref="model_inquiry_quote"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

<!-- 销售 - 完整 CRUD -->
        <record id="inquiry_quote_rule_sales" model="ir.rule">
            <field name="name">Inquiry Quote - Sales Full Access</field>
            <field name="model_id" ref="model_inquiry_quote"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="inquiry_quote_rule_manager" model="ir.rule">
            <field name="name">Inquiry Quote - Manager Access</field>
            <field name="model_id" ref="model_inquiry_quote"/>
            <field name="groups" eval="[(4, ref('group_inquiry_manager')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>