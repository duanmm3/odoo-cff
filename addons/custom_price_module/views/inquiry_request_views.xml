<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inquiry_request_list" model="ir.ui.view">
        <field name="name">报价需求列表</field>
        <field name="model">inquiry.request</field>
        <field name="arch" type="xml">
            <list string="报价需求" decoration-danger="state == 'draft'" decoration-info="state == 'quoted'" decoration-success="state == 'confirmed'" default_order="create_date desc">
                <field name="name" string="报价需求流水号"/>
                <field name="salesperson_id" string="销售员"/>
                <field name="product_name" string="产品型号"/>
                <field name="product_qty" string="数量"/>
                <field name="purchase_user_ids" widget="many2many_tags" string="采购受理人" optional="show"/>
                <field name="suggested_price" string="建议价格"/>
                <field name="lowest_quote_price" string="最低报价"/>
                <field name="lowest_quote_supplier_code" string="最低价的供应商编码"/>
                <field name="lowest_quote_buyer" string="最低报价采购员"/>
                <field name="state" widget="badge" string="状态" decoration-success="state == 'confirmed'" decoration-info="state == 'quoted'" decoration-warning="state == 'draft'"/>
                <button name="action_open_quote_dialog" type="object" string="我要报价" class="btn-primary" invisible="state == 'confirmed'"/>
                <button name="action_edit_request" type="object" string="修改" class="btn-secondary"/>
                <button name="action_unlink_request" type="object" string="删除" class="btn-danger" confirm="确定要删除这条报价需求吗？"/>
                <button name="action_confirm_request" type="object" string="确认需求" class="btn-success" invisible="state != 'quoted'"/>
            </list>
        </field>
    </record>

<!-- 批量导入客户端动作 -->
    <record id="action_inquiry_request_import" model="ir.actions.client">
        <field name="name">批量导入产品型号</field>
        <field name="tag">inquiry.request.import.wizard</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_inquiry_request"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- 报价需求动作 -->
    <record id="action_inquiry_request" model="ir.actions.act_window">
        <field name="name">报价需求</field>
        <field name="res_model">inquiry.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                暂无报价需求
            </p>
            <p>
                点击"新建"按钮创建报价需求
            </p>
        </field>
    </record>

    <record id="view_inquiry_request_form" model="ir.ui.view">
        <field name="name">报价需求表单</field>
        <field name="model">inquiry.request</field>
        <field name="arch" type="xml">
            <form string="报价需求">
                <header>
                    <button name="action_view_all_quotes" type="object" string="全部报价详情" class="btn-info" invisible="state == 'draft'"/>
                    <button name="action_confirm_request" type="object" string="确认需求" class="btn-primary" invisible="state != 'quoted'" confirm="确认后将生成销售报价单，请确保客户和产品信息正确。"/>
                    <button name="action_cancel_request" type="object" string="取消" invisible="state in ['confirmed', 'cancelled']"/>
                    <button name="action_draft_request" type="object" string="重置草稿" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quoted,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_confirm_request" type="object" string="确认需求"
                                class="oe_stat_button" icon="fa-check"
                                invisible="state != 'quoted'">
                            <field name="sale_order_id" widget="statinfo" string="销售报价单"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本信息">
                            <field name="partner_id" string="客户编码" placeholder="选择客户（可空）"/>
                            <field name="product_name" string="产品型号" placeholder="请输入产品型号"/>
                            <field name="product_qty" string="数量"/>
                            <field name="suggested_price" string="建议价格"/>
                        </group>
                        <group string="人员信息">
                            <field name="salesperson_id" string="销售员" readonly="1"/>
                            <field name="create_date" string="创建时间" readonly="1"/>
                        </group>
                    </group>
                    <group string="比价信息">
                        <group>
                            <field name="lowest_quote_price" string="最低报价" readonly="1"/>
                            <field name="lowest_quote_supplier_code" string="最低报价供应商编码" readonly="1"/>
                        </group>
                        <group>
                            <field name="lowest_quote_buyer" string="最低报价采购员" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="采购报价明细">
                            <field name="quote_ids" nolabel="1">
                                <list editable="bottom" create="0">
                                    <field name="buyer_id" string="采购员" readonly="1"/>
                                    <field name="supplier_code" string="供应商编码"/>
                                    <field name="price" string="报价"/>
                                    <field name="remark" string="备注"/>
                                    <field name="state" string="状态" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_inquiry_request_search" model="ir.ui.view">
        <field name="name">报价需求搜索</field>
        <field name="model">inquiry.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_name"/>
                <field name="salesperson_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="action_inquiry_request" model="ir.actions.act_window">
        <field name="name">报价需求</field>
        <field name="res_model">inquiry.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                暂无报价需求
            </p>
            <p>
                点击"新建"按钮创建报价需求
            </p>
        </field>
    </record>

    <record id="action_inquiry_request_import_wizard" model="ir.actions.act_window">
        <field name="name">批量导入产品型号</field>
        <field name="res_model">inquiry.request.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>